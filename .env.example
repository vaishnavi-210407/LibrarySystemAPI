# Copy these variables into your existing local .env. Do not share your real .env.
PORT=5000
MODE=development
JWT_SECRET_KEY=replace_with_a_long_random_secret
DEV_DB_URL=mongodb://127.0.0.1:27017/librarysystem
# Set this only if MODE=production
PRD_DB_URL=your_production_mongodb_connection_string

# Used only when running npm run seed:admin
SEED_ADMIN_NAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123


